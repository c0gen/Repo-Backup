<UserControl x:Class="RepoBackup.Desktop.Views.DestinationForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
      <TextBlock Text="Name" Margin="0,0,0,6" /><TextBox x:Name="NameInput" Text="Backup Drive" />
      <TextBlock Text="Repository folder" Margin="0,16,0,6" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="PathInput" /><Button Grid.Column="1" Content="Browse…" Click="BrowseClick" Margin="8,0,0,0" /></Grid>
      <CheckBox x:Name="ExistingInput" Content="Open an existing restic repository" Margin="0,18,0,0" />
      <TextBlock Text="Backup protection" Margin="0,18,0,6" />
      <ComboBox x:Name="ProtectionInput" SelectionChanged="ProtectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock x:Name="PasswordFreeHelp" Text="Anyone with access to this backup folder can restore your files. You won't need a recovery key on a replacement computer." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <StackPanel x:Name="KeySection" Visibility="Collapsed">
        <TextBlock Text="Recovery key (required to open a protected repository)" Margin="0,16,0,6" />
        <PasswordBox x:Name="KeyInput" />
        <Button Content="Load key file…" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="KeyFileClick" />
        <TextBlock Text="For a new repository, leave this blank to generate a key. You'll be offered a key export after creation. Keep it somewhere safe, separate from the backup drive." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
      </StackPanel>
  </StackPanel>
</UserControl>
