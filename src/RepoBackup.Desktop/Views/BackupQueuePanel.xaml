<UserControl x:Class="RepoBackup.Desktop.Views.BackupQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Background="#1B2938" Padding="10,8">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <TextBlock Text="Backup queue" FontWeight="SemiBold" Margin="0,0,16,0" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox x:Name="QueueList" ItemsSource="{Binding Items}" MaxHeight="92" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Queued backups">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="2,4" /></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Destination}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding IsWaiting,Converter={StaticResource Visible}}">
                <Button Content="↑" Command="{Binding DataContext.MoveUpCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="7,2" ToolTip="Move this backup up" AutomationProperties.Name="Move backup up" />
                <Button Content="↓" Command="{Binding DataContext.MoveDownCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="7,2" Margin="4,0" ToolTip="Move this backup down" AutomationProperties.Name="Move backup down" />
                <Button Content="Remove" Command="{Binding DataContext.RemoveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="7,2" ToolTip="Remove this waiting backup" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
