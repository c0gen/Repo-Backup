<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="RepoBackup.Desktop.Views.SnapshotsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="Snapshots &amp; Restore" Style="{StaticResource Heading}" /><TextBlock Text="Choose a recovery point. Restores always create a new directory." Style="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel><Button Content="Refresh snapshots" Command="{Binding RefreshSnapshotsCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,20,0,16"><TextBlock Text="Full projects and partial selections have separate version histories. Incomplete or interrupted snapshots may still contain recoverable files; their status stays visible." Style="{StaticResource Muted}" TextWrapping="Wrap" /></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" IsEnabled="{Binding IsIdle}" RowHeight="70"><DataGrid.Columns><DataGridTemplateColumn Header="Project / Recovery point" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /><TextBlock Text="{Binding ShortId}" Foreground="#6D839E" FontSize="10" Margin="0,3,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Coverage / Status" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Coverage}" FontSize="12" /><TextBlock Text="{Binding Status}" Foreground="{Binding Outcome,Converter={StaticResource OutcomeBrush}}" FontSize="11" Margin="0,5,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="0,0,0,10"><TextBox Text="{Binding FileSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search files and folders" /><TextBlock Text="Search files and folders…" Foreground="#8190A3" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FileSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding FileView}" SelectedItem="{Binding SelectedSnapshotFile}" IsEnabled="{Binding IsIdle}" RowHeight="35"><DataGrid.Columns><DataGridTextColumn Header="File or folder inside snapshot" Binding="{Binding DisplayPath}" Width="*" /><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" /></DataGrid.Columns></DataGrid></Grid>
    </Grid>
    <WrapPanel Grid.Row="3" Margin="0,18,0,0"><Button Content="Restore entire recovery point" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="Restore selected file / folder" Command="{Binding RestoreFileCommand}" Margin="10,0,0,0" /><Button Content="Test restore" Command="{Binding TestRestoreCommand}" Margin="10,0,0,0" /></WrapPanel>
  </Grid>
</UserControl>
