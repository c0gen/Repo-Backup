<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="RepoBackup.Desktop.Views.ActivityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="150" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Activity" Style="{StaticResource Heading}" /><TextBlock Text="Backup, verification and cleanup results remain separate." Style="{StaticResource Muted}" Margin="0,7,0,20" /></StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedActivity}" RowHeight="52"><DataGrid.Columns><DataGridTextColumn Header="Project / Selection" Binding="{Binding ProjectName}" Width="*" /><DataGridTextColumn Header="Started" Binding="{Binding StartedAt,Converter={StaticResource DisplayLabel}}" Width="145" /><DataGridTextColumn Header="Coverage" Binding="{Binding Coverage,Converter={StaticResource DisplayLabel}}" Width="125" /><DataGridTemplateColumn Header="Backup" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Backup,Converter={StaticResource DisplayLabel}}" Foreground="{Binding Backup,Converter={StaticResource OutcomeBrush}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Verification" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Verification,Converter={StaticResource DisplayLabel}}" Foreground="{Binding Verification,Converter={StaticResource OutcomeBrush}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Cleanup" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Cleanup,Converter={StaticResource DisplayLabel}}" Foreground="{Binding Cleanup,Converter={StaticResource OutcomeBrush}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Files" Binding="{Binding Files,StringFormat=N0}" Width="70" /></DataGrid.Columns></DataGrid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0"><ScrollViewer><TextBlock Text="{Binding ActivityDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" /></ScrollViewer></Border>
  </Grid>
</UserControl>
