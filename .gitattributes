# Normalize text in Git; use Windows line endings for PowerShell scripts.
* text=auto

*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.xaml text eol=lf
*.manifest text eol=lf
*.json text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.ps1 text eol=crlf

# Keep screenshots and packaged binaries byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.pdb binary
