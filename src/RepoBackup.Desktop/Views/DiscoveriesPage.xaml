<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="RepoBackup.Desktop.Views.DiscoveriesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="Discoveries" Style="{StaticResource Heading}" /><TextBlock Text="Review new projects before including them in backups." Style="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Scan for repositories" Command="{Binding ScanCommand}" Margin="0,0,10,0" /><Button Content="Refresh" Command="{Binding RefreshCommand}" /></StackPanel></Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,18" Background="#2E291E" BorderBrush="#81662E"><TextBlock Text="Drive roots, Downloads and missing locations stay in this inbox until reviewed. Including a project enables its full-project backup; scheduling stays off until configured." Foreground="#E7CB91" TextWrapping="Wrap" /></Border>
    <Grid Grid.Row="2" Margin="0,0,0,16"><TextBox Text="{Binding DiscoverySearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search projects, paths or programs" /><TextBlock Text="Search projects, paths or programs…" Foreground="{StaticResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DiscoverySearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ScrollViewer Grid.Row="3"><StackPanel><ItemsControl ItemsSource="{Binding DiscoveryView}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Paths}" Style="{StaticResource Muted}" Margin="0,6,20,0" TextWrapping="Wrap" /><TextBlock Text="{Binding DiscoveryDetail}" Foreground="#C4A669" FontSize="11" Margin="0,8,20,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Include project" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{Binding DataContext.ApproveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><Button Grid.Column="2" Content="Dismiss" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding DataContext.DismissCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Expander Header="Dismissed projects — reactivate" Margin="0,16,0,0"><ItemsControl ItemsSource="{Binding DismissedProjects}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,8,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Reactivate" Command="{Binding DataContext.ApproveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Paths}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,12,0" /></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></ScrollViewer>
  </Grid>
</UserControl>
