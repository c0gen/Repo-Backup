<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="RepoBackup.Desktop.Views.DestinationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Margin="26"><Grid><StackPanel><TextBlock Text="Destinations" Style="{StaticResource Heading}" /><TextBlock Text="Local drives, external drives and UNC network folders." Style="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel><Button Content="Add / open repository" Command="{Binding AddDestinationCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid>
    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding NeedsDestination,Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="Give your backups a home" Style="{StaticResource Subheading}" /><TextBlock Text="Add a destination on a backup drive or network share. You can create a repository or open existing backups." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel></Border>
    <ListBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" IsEnabled="{Binding CanEditCatalog}" Margin="0,22,0,0"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="30" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" Margin="0,6,0,0" /><TextBlock Text="{Binding Protection,Converter={StaticResource DisplayLabel}}" Margin="0,7,0,0" /><TextBlock Text="{Binding RepositoryId,StringFormat=Repository identity: {0}}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" /><TextBlock Text="{Binding VerifiedAt,StringFormat=Last data verification: {0:g}}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Text="{Binding LatestVerificationText}" TextWrapping="Wrap" Foreground="#FFC361" Margin="0,18,0,0" /><WrapPanel Margin="0,18,0,0"><Button Content="Verify repository" Command="{Binding VerifyCommand}" /><Button Content="Export recovery key" Command="{Binding ExportKeyCommand}" Margin="10,0,0,0" /><Button Content="Rebuild catalog from snapshots" Command="{Binding RecoverCatalogCommand}" Margin="10,0,0,0" /></WrapPanel>
    <Border Style="{StaticResource Card}" Margin="0,24,0,0"><StackPanel><TextBlock Text="Recovery on another computer" Style="{StaticResource Subheading}" /><TextBlock Text="On a fresh installation, use Add / open repository and choose Open existing. Password-free backups need only the backup folder. For a protected repository, choose recovery-key protection and load your exported key. Rebuild the catalog to recover project identities and browse snapshots. Relink source roots before enabling future backups." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" /><TextBlock Text="Protected repositories save their keys under your Windows user account on this computer. Export a copy and keep it safe, separate from the backup drive. Catalog exports and job logs never contain recovery keys." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" /></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
