<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="RepoBackup.Desktop.Views.DestinationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Margin="26"><Grid><StackPanel><TextBlock Text="Destinations" Style="{StaticResource Heading}" /><TextBlock Text="Local drives, external drives and UNC network folders." Style="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel><Button Content="Add / open repository" Command="{Binding AddDestinationCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid>
    <ListBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" Margin="0,22,0,0"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="30" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" Margin="0,6,0,0" /><TextBlock Text="{Binding RepositoryId,StringFormat=Repository identity: {0}}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" /><TextBlock Text="{Binding VerifiedAt,StringFormat=Last data verification: {0:g}}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Verify repository" Command="{Binding VerifyCommand}" /><Button Content="Export recovery key" Command="{Binding ExportKeyCommand}" Margin="10,0,0,0" /><Button Content="Rebuild catalog from snapshots" Command="{Binding RecoverCatalogCommand}" Margin="10,0,0,0" /></StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,24,0,0"><StackPanel><TextBlock Text="Recovery on another computer" Style="{StaticResource Subheading}" /><TextBlock Text="Keep the repository and its exported recovery key. On a fresh installation, use Add / open repository, choose Open existing and supply the key. Rebuild the catalog to recover project identities and browse snapshots. Relink source roots before enabling future backups." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" /><TextBlock Text="Recovery keys are encrypted with your Windows user account on this computer. JSON exports and job logs never contain them." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" /></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
