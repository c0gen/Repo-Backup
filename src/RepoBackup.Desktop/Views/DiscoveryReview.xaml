<UserControl x:Class="RepoBackup.Desktop.Views.DiscoveryReview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RepoBackup.Desktop.Views">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,8"><Button Content="Add folder" Command="{Binding AddFolderCommand}" Margin="0,0,8,8" /><Button Content="Scan for repositories" Command="{Binding ScanCommand}" Margin="0,0,8,8" /><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,0,8" /></WrapPanel>
    <views:LoadingStatus Grid.Row="1" State="{Binding DiscoveryLoad}" Message="Looking for projects…" RetryCommand="{Binding RefreshCommand}" />
    <TextBlock Grid.Row="2" Text="{Binding DiscoveryWarningText}" TextWrapping="Wrap" Foreground="#E7CB91" Margin="0,8,0,12" Visibility="{Binding HasDiscoveryWarnings,Converter={StaticResource Visible}}" />
    <StackPanel Grid.Row="3"><TextBlock Text="Include the projects you want to protect. Broad or unavailable locations need extra review. Scheduling stays optional." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,12" />
      <Grid Margin="0,0,0,14"><TextBox Text="{Binding DiscoverySearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search discoveries" /><TextBlock Text="Search projects, paths or programs…" Foreground="{StaticResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DiscoverySearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    </StackPanel>
    <ScrollViewer Grid.Row="4"><StackPanel>    <Border VerticalAlignment="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding ShowDiscoveriesEmpty,Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="{Binding DiscoveriesEmptyTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding DiscoveriesEmptyDetail}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel></Border><ItemsControl ItemsSource="{Binding DiscoveryView}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Paths}" Style="{StaticResource Muted}" Margin="0,6,20,0" TextWrapping="Wrap" /><TextBlock Text="{Binding DiscoveryDetail}" Foreground="#C4A669" FontSize="11" Margin="0,8,20,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Include project" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{Binding DataContext.ApproveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><Button Grid.Column="2" Content="Dismiss" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding DataContext.DismissCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Expander Header="Dismissed projects — reactivate" Margin="0,16,0,0"><ItemsControl ItemsSource="{Binding DismissedProjects}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,8,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Reactivate" Command="{Binding DataContext.ApproveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Paths}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,12,0" /></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></ScrollViewer>

  </Grid>
</UserControl>
