<Window Style="{StaticResource {x:Type Window}}" x:Class="RepoBackup.Desktop.Views.FolderSelectionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RepoBackup.Desktop.Views" Title="Save a folder selection" Width="680" Height="660" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Choose folders or files" Style="{StaticResource Subheading}" /><TextBlock Text="This creates a partial-selection series with its own ten versions. It does not change the project's full-backup status. Checking a folder includes its contents; uncheck the parent to choose individual children." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,16" /></StackPanel><TextBox Grid.Row="1" x:Name="NameInput" Text="Selected folders" Margin="0,0,0,14" ToolTip="Selection name" /><TreeView Grid.Row="2" x:Name="FolderTree"><TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="False" /><EventSetter Event="Expanded" Handler="FolderExpanded" /></Style></TreeView.ItemContainerStyle><TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type views:FolderNode}" ItemsSource="{Binding Children}"><CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" ToolTip="{Binding Path}" Margin="3,4" /></HierarchicalDataTemplate></TreeView.Resources></TreeView><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" IsCancel="True" /><Button Content="Save partial selection" Click="SaveClick" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /></StackPanel></Grid>
</Window>
