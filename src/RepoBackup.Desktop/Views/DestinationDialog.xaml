<Window Style="{StaticResource {x:Type Window}}" x:Class="RepoBackup.Desktop.Views.DestinationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RepoBackup.Desktop.Views" Title="Backup destination" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea},Path=Height}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Add a backup repository" Style="{StaticResource Subheading}" />
      <TextBlock Text="New repositories use an empty folder on a local drive or UNC share." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18" />
      <views:DestinationForm x:Name="Form" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" /><Button Content="Save repository" Click="SaveClick" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /></StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
