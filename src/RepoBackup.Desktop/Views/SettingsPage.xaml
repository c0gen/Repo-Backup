<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="RepoBackup.Desktop.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Margin="26"><TextBlock Text="Settings" Style="{StaticResource Heading}" /><TextBlock Text="Manual by default. Configure optional Windows integration here." Style="{StaticResource Muted}" Margin="0,7,0,22" />
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Scheduling" Style="{StaticResource Subheading}" /><TextBlock Text="Runs under your signed-in Windows account while the GUI is closed. Missed runs catch up, and overlapping jobs are skipped. Install the packaged app first to use its stable runner path. Scheduled backups use live mode." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,16" /><CheckBox Content="Enable this schedule" IsChecked="{Binding EnableSchedule}" /><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Frequency" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding ScheduleKinds}" SelectedItem="{Binding ScheduleKind}" /></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Time" Style="{StaticResource Muted}" Margin="0,0,0,6" /><TextBox Text="{Binding ScheduleTime}" /></StackPanel><StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="Weekly day" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding ScheduleDays}" SelectedItem="{Binding ScheduleDay}" /></StackPanel><StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock Text="Interval hours" Style="{StaticResource Muted}" Margin="0,0,0,6" /><TextBox Text="{Binding ScheduleHours}" /></StackPanel><StackPanel Grid.Column="4" Margin="10,0,0,0"><TextBlock Text="Scope" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding ScheduleScopes}" SelectedItem="{Binding ScheduleScope}" /></StackPanel></Grid><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Save schedule" Command="{Binding SaveScheduleCommand}" /><Button Content="Remove selected schedule" Command="{Binding DeleteScheduleCommand}" Margin="10,0,0,0" /></StackPanel><ListBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" Margin="0,14,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name}" /><Run Text=" · " /><Run Text="{Binding Kind}" /><Run Text=" · Enabled: " /><Run Text="{Binding Enabled}" /></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Backup mode" Style="{StaticResource Subheading}" /><CheckBox Content="Use Windows VSS for manual backups (requires running as Administrator)" IsChecked="{Binding UseVss}" Margin="0,14,0,0" /><TextBlock Text="Live backups run as a standard user and report observed file changes or unreadable files as incomplete coverage. Live mode does not promise a single instant across all files. VSS failures stay visible and never silently switch to live mode." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
      <TextBlock Text="Optional discovery hooks" Style="{StaticResource Subheading}" />
      <TextBlock Text="Register projects as you use each program. New folders require review before backup. Saved-project discovery also works without hooks. Refresh to check verification after the first event." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,16" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Codex · SessionStart" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding CodexHookStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
        <Button Grid.Column="2" Content="Install Codex hook" Command="{Binding InstallHookCommand}" />
      </Grid>
      <TextBlock Text="Review and trust the hook through Codex /hooks." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,14" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Claude Code · SessionStart" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding ClaudeHookStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
        <Button Grid.Column="2" Content="Install Claude Code hook" Command="{Binding InstallClaudeHookCommand}" />
      </Grid>
      <TextBlock Text="Review the hook in Claude Code /hooks." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,14" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Antigravity · PostInvocation" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding AntigravityHookStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
        <Button Grid.Column="2" Content="Install Antigravity hook" Command="{Binding InstallAntigravityHookCommand}" />
      </Grid>
      <TextBlock Text="Requires a build with native Hooks support. Review Customizations &gt; Hooks and send a prompt to verify registration." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Catalog &amp; recovery" Style="{StaticResource Subheading}" /><TextBlock Text="{Binding DataPath}" Style="{StaticResource Muted}" Margin="0,10,0,0" /><TextBlock Text="{Binding EngineVersion}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,14" /><StackPanel Orientation="Horizontal"><Button Content="Export catalog" Command="{Binding ExportCatalogCommand}" /><Button Content="Import catalog" Command="{Binding ImportCatalogCommand}" Margin="10,0,0,0" /></StackPanel></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
