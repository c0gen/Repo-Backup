<Window Style="{StaticResource {x:Type Window}}" x:Class="RepoBackup.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:RepoBackup.Desktop.Views" Title="Repo Backup" Icon="Assets/RepoBackup.ico" Width="1500" Height="960" MinWidth="1140" MinHeight="730" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" BorderThickness="1" BorderBrush="#3B4857">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="6" /></shell:WindowChrome.WindowChrome>
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#151E28"><Grid><StackPanel Orientation="Horizontal" Margin="18,0"><Image Source="Assets/RepoBackup.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,13,0" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="Repo Backup" FontSize="15" VerticalAlignment="Center" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Width="48" Style="{StaticResource LinkButton}" Foreground="{StaticResource TextBrush}" Click="MinimizeClick" /><Button Content="□" Width="48" Style="{StaticResource LinkButton}" Foreground="{StaticResource TextBrush}" Click="MaximizeClick" /><Button Content="✕" Width="48" Style="{StaticResource LinkButton}" Foreground="{StaticResource TextBrush}" Click="CloseClick" /></StackPanel></Grid></Border>
    <Grid Grid.Row="1" IsEnabled="{Binding Setup.IsClosed}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="212" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,24"><TextBlock Text="{Binding ScheduleSummary}" Style="{StaticResource Muted}" Margin="24,12" /><Button Style="{StaticResource NavButton}" Tag="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,16,0" /><TextBlock Text="Settings" /></StackPanel></Button></StackPanel>
        <StackPanel Margin="0,12,0,0">
          <Button Command="{Binding NavigateCommand}" CommandParameter="Projects"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsProjects}" Value="True"><Setter Property="Background" Value="#223957" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,16,0" /><TextBlock Text="Projects" /></StackPanel></Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Discoveries"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDiscoveries}" Value="True"><Setter Property="Background" Value="#223957" /></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="160"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,16,0" /><TextBlock Grid.Column="1" Text="Discoveries" /><Border Grid.Column="2" Background="#FFC361" CornerRadius="10" Padding="6,1" Visibility="{Binding HasDiscoveries,Converter={StaticResource Visible}}"><TextBlock Text="{Binding DiscoveryCount}" Foreground="#30230E" FontWeight="SemiBold" FontSize="11" /></Border></Grid></Button>
          <Button Style="{StaticResource NavButton}" Tag="{Binding IsSnapshots}" Command="{Binding NavigateCommand}" CommandParameter="Snapshots &amp; Restore"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Margin="0,0,16,0" /><TextBlock Text="Snapshots &amp; Restore" FontSize="12" /></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Tag="{Binding IsDestinations}" Command="{Binding NavigateCommand}" CommandParameter="Destinations"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Margin="0,0,16,0" /><TextBlock Text="Destinations" /></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Tag="{Binding IsActivity}" Command="{Binding NavigateCommand}" CommandParameter="Activity"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,16,0" /><TextBlock Text="Activity" /></StackPanel></Button>
          <Border Margin="20,28,20,0" BorderBrush="#2B3948" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="YOUR PROJECTS, RECOVERABLE" FontSize="9" Foreground="#6F839D" FontWeight="SemiBold" /><TextBlock Text="Versioned backups.&#x0a;Ready when you need them." Style="{StaticResource Muted}" FontSize="11" LineHeight="20" Margin="0,8,0,0" /></StackPanel></Border>
        </StackPanel>
      </DockPanel></Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="30" /></Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="20,0">
            <views:LoadingStatus State="{Binding CatalogLoad}" Message="Loading your projects and destinations…" RetryCommand="{Binding RetryCatalogCommand}" />
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12" Visibility="{Binding Setup.ShowResume,Converter={StaticResource Visible}}"><DockPanel><Button DockPanel.Dock="Right" Content="Continue setup" Command="{Binding Setup.OpenCommand}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" /><TextBlock Text="Finish choosing your backup destination and projects." TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel></Border>
          </StackPanel>
        <Grid><views:ProjectsPage Visibility="{Binding IsProjects,Converter={StaticResource Visible}}" /><views:DiscoveriesPage Visibility="{Binding IsDiscoveries,Converter={StaticResource Visible}}" /><views:SnapshotsPage Visibility="{Binding IsSnapshots,Converter={StaticResource Visible}}" /><views:DestinationsPage Visibility="{Binding IsDestinations,Converter={StaticResource Visible}}" /><views:ActivityPage Visibility="{Binding IsActivity,Converter={StaticResource Visible}}" /><views:SettingsPage Visibility="{Binding IsSettings,Converter={StaticResource Visible}}" /></Grid>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#1B2938" Padding="20,12" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ProgressStage}" Margin="0,0,0,8" /><ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent,Mode=OneWay}" Maximum="100" /></StackPanel><Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="22,0,0,0" /></Grid></Border>
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Background="#18232E" Padding="20,12"><StackPanel>
          <DockPanel Visibility="{Binding HasDestinations,Converter={StaticResource Visible}}"><TextBlock Text="Backup destination" Style="{StaticResource Muted}" Margin="0,0,18,0" VerticalAlignment="Center" /><ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding Destinations}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDestination}" IsEnabled="{Binding CanEditCatalog}" ToolTip="{Binding SelectedDestination.Path}" /><TextBlock Text="{Binding DestinationState}" Margin="18,0" VerticalAlignment="Center" FontSize="12" /><TextBlock Text="{Binding DestinationFreeSpace}" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11" /></DockPanel>
          <DockPanel Visibility="{Binding NeedsDestination,Converter={StaticResource Visible}}"><Button Content="Choose backup destination" Command="{Binding Setup.OpenCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="18,0,0,0" /><TextBlock Text="Choose where to store backups before your first run." TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
          <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Back Up All Enabled" Command="{Binding BackupAllCommand}" Margin="0,0,10,0" Padding="16,10" BorderBrush="#508BCE" /><Button Content="{Binding SelectedBackupLabel}" Command="{Binding BackupSelectedCommand}" Style="{StaticResource PrimaryButton}" Padding="20,10" MaxWidth="500" ToolTip="{Binding SelectedBackupLabel}" /></WrapPanel>
        </StackPanel></Border>
        <Grid Grid.Row="3" Margin="20,0"><TextBlock Text="{Binding ScheduleSummary,StringFormat=Manual backups · {0}}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="700" TextTrimming="CharacterEllipsis" /></Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="#E0101821" Visibility="{Binding Setup.IsOpen,Converter={StaticResource Visible}}"><views:SetupWizardView DataContext="{Binding Setup}" /></Border>
  </Grid>
</Window>
