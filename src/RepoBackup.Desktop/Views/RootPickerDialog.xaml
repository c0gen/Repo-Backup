<Window Style="{StaticResource {x:Type Window}}" x:Class="RepoBackup.Desktop.Views.RootPickerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Relink source" Width="620" Height="300" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Choose the source root that moved. Its identity and history stay intact." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14" /><ListBox Grid.Row="1" x:Name="RootsList" DisplayMemberPath="Path" /><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" IsCancel="True" /><Button Content="Locate folder…" Click="LocateClick" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /></StackPanel></Grid>
</Window>
