<UserControl x:Class="RepoBackup.Desktop.Views.BackupQueueStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#1B2938" Padding="20,10">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,18,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" Style="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" />
          <TextBlock x:Name="ProjectLine" Text="{Binding CurrentProject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentProject}" />
        </DockPanel>
        <TextBlock FontSize="11" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding CurrentDestination,Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary,Mode=OneWay}" />
        </TextBlock>
        <StackPanel Visibility="{Binding IsRunning,Converter={StaticResource Visible}}">
          <DockPanel Margin="0,5,0,5">
            <TextBlock Text="{Binding ProgressStage}" FontSize="11" Margin="0,0,12,0" />
            <TextBlock x:Name="SummaryLine" Text="{Binding ProgressSummary}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressSummary}" />
          </DockPanel>
          <ProgressBar x:Name="Progress" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent,Mode=OneWay}" Maximum="100" />
          <TextBlock x:Name="FileLine" Text="{Binding ProgressFileLabel}" FontSize="11" Style="{StaticResource Muted}" Margin="0,5,0,0"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressCurrentFile}" Visibility="{Binding HasProgressCurrentFile,Converter={StaticResource Visible}}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="View queue" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Activity" Padding="10,5" />
          <Button x:Name="PauseButton" Content="{Binding PauseLabel}" Command="{Binding PauseResumeCommand}" Margin="8,0,0,0" Padding="10,5" ToolTip="Finish the current project and pending verification before pausing." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
          <Button x:Name="CancelCurrentButton" Content="Cancel current" Command="{Binding CancelCurrentCommand}" Padding="10,5" Margin="0,0,8,0" Visibility="{Binding CanCancelCurrent,Converter={StaticResource Visible}}" ToolTip="Cancel this project and continue the remaining queue." />
          <Button x:Name="CancelAllButton" Content="Cancel all" Command="{Binding CancelAllCommand}" Padding="10,5" ToolTip="Discard waiting backups and cancel active backup, verification or cleanup work." />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
