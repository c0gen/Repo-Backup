<Window Style="{StaticResource {x:Type Window}}" x:Class="RepoBackup.Desktop.Views.DestinationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Backup destination" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24"><TextBlock Text="Add a backup repository" Style="{StaticResource Subheading}" /><TextBlock Text="New repositories use an empty folder on a local drive or UNC share." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18" /><TextBlock Text="Name" Margin="0,0,0,6" /><TextBox x:Name="NameInput" Text="Backup Drive" /><TextBlock Text="Repository folder" Margin="0,16,0,6" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="PathInput" /><Button Grid.Column="1" Content="Browse…" Click="BrowseClick" Margin="8,0,0,0" /></Grid><CheckBox x:Name="ExistingInput" Content="Open an existing restic repository" Margin="0,18,0,0" /><TextBlock Text="Recovery key (required for existing repositories)" Margin="0,16,0,6" /><PasswordBox x:Name="KeyInput" /><Button Content="Load key file…" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="KeyFileClick" /><TextBlock Text="A new recovery key is generated if this is blank. Export it after creating the repository and store it separately." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" /><Button Content="Save repository" Click="SaveClick" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /></StackPanel></StackPanel>
</Window>
