<Window Style="{StaticResource {x:Type Window}}" x:Class="RepoBackup.Desktop.Views.ExclusionsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Exclusion rules" Width="550" Height="610" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="130" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Exclusions" Style="{StaticResource Subheading}" /><TextBlock Text="Uncheck a directory to include it. Tracked Git files stay included; .gitignore does not control backups. build and dist stay included unless added below." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,16" /></StackPanel><ScrollViewer Grid.Row="1"><ItemsControl x:Name="RulesList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Excluded}" Margin="0,5" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Grid.Row="2" Text="Additional relative patterns — one per line (for example: dist/*)" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,6" /><TextBox Grid.Row="3" x:Name="PatternsInput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" /><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" IsCancel="True" /><Button Content="Apply rules" Click="ApplyClick" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /></StackPanel></Grid>
</Window>
