<UserControl x:Class="RepoBackup.Desktop.Views.OperationStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#1B2938" Padding="20,12">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="StageLine" Text="{Binding ProgressStage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressStage}" />
          <TextBlock x:Name="SummaryLine" Grid.Column="1" Text="{Binding ProgressSummary}" Style="{StaticResource Muted}" Margin="16,0,0,0" Visibility="{Binding HasProgressSummary,Converter={StaticResource Visible}}" />
        </Grid>
        <ProgressBar x:Name="Progress" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent,Mode=OneWay}" Maximum="100" />
        <TextBlock x:Name="FileLine" Text="{Binding ProgressFileLabel}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressCurrentFile}" Visibility="{Binding HasProgressCurrentFile,Converter={StaticResource Visible}}" />
      </StackPanel>
      <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="22,0,0,0" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
