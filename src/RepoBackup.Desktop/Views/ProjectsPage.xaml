<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="RepoBackup.Desktop.Views.ProjectsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:RepoBackup.Desktop.ViewModels" xmlns:views="clr-namespace:RepoBackup.Desktop.Views">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
    <Grid Margin="20,20,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock Text="Projects" Style="{StaticResource Heading}" /><TextBlock Text="{Binding ProjectSummary}" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" Style="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"><Button Style="{StaticResource LinkButton}" Command="{Binding AddFolderCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="24" Margin="0,-5,8,-5" /><TextBlock Text="Add Folder" /></StackPanel></Button><Button Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}" Margin="6,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="⟳" FontSize="23" Margin="0,-4,8,-4" /><TextBlock Text="Refresh" /></StackPanel></Button></StackPanel></Grid>
      <Border Grid.Row="1" Background="#30291C" BorderBrush="#A67523" BorderThickness="1" CornerRadius="5" Margin="0,18,0,0" Padding="14,12" Visibility="{Binding HasDiscoveries,Converter={StaticResource Visible}}"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="⚠" Foreground="#FFC361" FontSize="23" Margin="0,0,14,0" /><StackPanel><TextBlock Text="{Binding DiscoverySummary}" Foreground="#FFC361" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="Choose which projects to include." Foreground="#D6CAB3" Margin="0,4,0,0" /></StackPanel></StackPanel><Button Content="Review discoveries" Command="{Binding NavigateCommand}" CommandParameter="Discoveries" HorizontalAlignment="Right" BorderBrush="#AC8951" Background="#3B3223" /></Grid></Border>
      <StackPanel Grid.Row="2" Margin="0,18,0,12"><views:LoadingStatus State="{Binding DiscoveryLoad}" Message="Looking for projects…" RetryCommand="{Binding RefreshCommand}" /><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search projects, paths or programs" AutomationProperties.Name="Search projects" /><TextBlock Text="Search projects, paths or programs…" Foreground="#8190A3" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><WrapPanel Margin="0,8,0,0"><ComboBox Width="138" ToolTip="Needs backup: no verified full backup here, or a later unsuccessful full attempt. Does not detect file changes." ItemsSource="{Binding ProjectFilters}" SelectedItem="{Binding ProjectFilter}" Margin="0,0,8,0" /><ComboBox Width="180" ItemsSource="{Binding Selections}" SelectedItem="{Binding ActiveSelection}" Margin="0,0,8,0" ToolTip="Full projects or a saved partial selection" /><TextBlock Text="{Binding EnabledSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" /></WrapPanel></StackPanel>
      <Grid Grid.Row="3"><DataGrid ItemsSource="{Binding ProjectView}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanEditCatalog}" RowHeight="72"><DataGrid.Columns>
        <DataGridTemplateColumn Width="45"><DataGridTemplateColumn.Header><Button Content="☑" Style="{StaticResource LinkButton}" Command="{Binding ToggleAllCommand}" Padding="0" ToolTip="Select or clear all visible projects" /></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Project / Source" Width="*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14" /><TextBlock Text="{Binding Programs}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,3,0,0" ToolTip="{Binding Programs}" /><TextBlock Text="{Binding Paths}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,3,0,0" ToolTip="{Binding Paths}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Enabled" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Last full backup" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LastBackupText}" FontSize="12" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Status" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="127" ToolTip="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns></DataGrid><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450" Visibility="{Binding ShowProjectsEmpty,Converter={StaticResource Visible}}"><TextBlock Text="{Binding ProjectsEmptyTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="{Binding ProjectsEmptyDetail}" TextWrapping="Wrap" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,0" /><WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0"><Button Content="Review discoveries" Command="{Binding NavigateCommand}" CommandParameter="Discoveries" Margin="0,0,8,0" /><Button Content="Add folder" Command="{Binding AddFolderCommand}" /></WrapPanel></StackPanel></Grid>
      <TextBlock Grid.Row="4" Text="{Binding SelectedSummary}" Style="{StaticResource Muted}" Margin="0,10,0,10" FontSize="12" />
      <Border Grid.Row="5" Style="{StaticResource Card}" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Last completed run" Style="{StaticResource Subheading}" /><TextBlock Text="{Binding LastRunTime}" Style="{StaticResource Muted}" Margin="16,3,0,0" FontSize="12" /></StackPanel><Border Background="#1B2936" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,12,0,0" Visibility="{Binding HasLastRun,Converter={StaticResource Visible}}"><WrapPanel><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{Binding LastRun.Backup,Converter={StaticResource OutcomeBrush}}" Margin="0,0,10,0" /><TextBlock Text="Backup" Margin="0,0,10,0" /><TextBlock Text="{Binding LastRun.Backup}" Foreground="{Binding LastRun.Backup,Converter={StaticResource OutcomeBrush}}" FontSize="12" /></StackPanel><StackPanel Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="Verification" Margin="0,0,10,0" /><TextBlock Text="{Binding LastRun.Verification}" Foreground="{Binding LastRun.Verification,Converter={StaticResource OutcomeBrush}}" FontSize="12" /></StackPanel><StackPanel Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="Cleanup" Margin="0,0,10,0" /><TextBlock Text="{Binding LastRun.Cleanup}" Foreground="{Binding LastRun.Cleanup,Converter={StaticResource OutcomeBrush}}" FontSize="12" /></StackPanel></WrapPanel></Border><Button Content="View activity  ›" Command="{Binding NavigateCommand}" CommandParameter="Activity" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Padding="0,9,0,0" FontSize="12" /></StackPanel></Border>
    </Grid>
    <Border Grid.Column="1" Background="#141E28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"><ScrollViewer Padding="18,22" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="Project preview" Style="{StaticResource Subheading}" /><views:LoadingStatus State="{Binding PreviewLoad}" Message="Calculating project preview…" RetryCommand="{Binding RetryPreviewCommand}" /><TextBlock Text="Select a project to inspect its sources and size." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="{Binding NeedsPreviewSelection,Converter={StaticResource Visible}}" /><TextBlock Text="{Binding PreviewTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,8" TextWrapping="Wrap" /><Border Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="{Binding CoverageText}" Foreground="{StaticResource AccentBrush}" FontSize="12" /></Border>
      <Grid Margin="0,24,0,8"><TextBlock Text="Included sources" FontWeight="SemiBold" /><Button Content="Choose folders" Style="{StaticResource LinkButton}" Command="{Binding SaveSelectionCommand}" HorizontalAlignment="Right" Padding="0" FontSize="11" /></Grid>
      <TreeView ItemsSource="{Binding SourceTree}"><TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type vm:SourceNode}" ItemsSource="{Binding Children}"><Grid MaxWidth="170"><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="#F7C762" FontSize="16" VerticalAlignment="Top" Margin="0,3,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,4,0,0" /></StackPanel></Grid></HierarchicalDataTemplate></TreeView.Resources></TreeView>
      <Separator Margin="0,13" />
      <Grid><TextBlock Text="Excluded by default" FontWeight="SemiBold" /><Button Content="Edit" Style="{StaticResource LinkButton}" Command="{Binding EditExclusionsCommand}" HorizontalAlignment="Right" Padding="0" /></Grid><TextBlock Text="{Binding ExclusionText}" ToolTip="{Binding ExclusionDetails}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" LineHeight="24" Margin="0,12,0,0" /><TextBlock Text="Tracked files preserved · build &amp; dist included." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" /><Separator Margin="0,13" />
      <Grid><TextBlock Text="Files" /><TextBlock Text="{Binding PreviewFiles}" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Estimated source size" /><TextBlock Text="{Binding PreviewSize}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Exclusions applied to estimate." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" /><TextBlock Text="{Binding PreviewWarnings}" Foreground="#FFC361" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0" Visibility="{Binding HasPreviewWarnings,Converter={StaticResource Visible}}" /><Separator Margin="0,13" />
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="24" Margin="0,0,12,0" /><StackPanel><TextBlock Text="Latest 10 successful versions" /><TextBlock Text="Per project or saved selection" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel></StackPanel><Button Content="Relink a moved source" Style="{StaticResource LinkButton}" Command="{Binding RelinkCommand}" HorizontalAlignment="Left" Padding="0,20,0,0" FontSize="12" />
    </StackPanel></ScrollViewer></Border>
  </Grid>
</UserControl>
